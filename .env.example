# PerMan - Personal Management & Task Reminder App
# Environment Configuration Template

# -----------------------------------------------------------------------------
# Supabase Configuration (Existing project: "random")
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Application URLs & Routing
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Reminder Engine & Cron Security
# -----------------------------------------------------------------------------
# Bearer token for authenticating scheduled cron invocations (e.g. Vercel Cron or external scheduler)
CRON_SECRET=your-secure-cron-secret-token

# -----------------------------------------------------------------------------
# Notification Provider (Optional / Extensible: Resend, SMTP, Webhook)
# -----------------------------------------------------------------------------
NOTIFICATION_PROVIDER=console # options: console, resend, webhook
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@perman.app

# -----------------------------------------------------------------------------
# Remote MCP / OAuth Configuration
# -----------------------------------------------------------------------------
MCP_ENABLED=true
MCP_SERVER_NAME=perman-mcp
MCP_SERVER_VERSION=1.0.0
